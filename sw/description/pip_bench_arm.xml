       <body name="finger_b" gravcomp="1" pos="-0.05 0 -0.11599999999999999"><joint name="fb" type="slide" axis="1 0 0" range="0 0.045" damping="5"/>
        <geom type="box" size="0.005 0.012 0.025" mass="0.03" friction="1.5 0.02 0.002" rgba=".95 .55 .2 1"/></body>
      </body>
     </body>
    </body>
   </body>
  </body>
 </body>
 <body name="cube" pos="0.45 0 0.775"><freejoint/>
  <geom type="box" size="0.022 0.022 0.022" mass="0.1" friction="1.2 0.01 0.001" rgba=".2 .5 .9 1"/></body>
 <site name="goal" pos="0.40 -0.15 0.752" size="0.03 0.001" type="cylinder" rgba=".2 .8 .3 .5"/>
</worldbody>
<equality><joint joint1="fb" joint2="fa" polycoef="0 1 0 0 0"/></equality>
<actuator>
