  (text "Arm watchdog: GPIO17 → U5a (U30) Schmitt → U5 '123, 25 ms → WD_OK" (at 25.4 40 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "828f0fd8-4b95-5254-b10e-84bfa1c45aff"))
  (text "E-stop channel b (S1b-S2b in series = S1b ∧ S2b) and U13 → GPIO22 ESTOP_SENSE" (at 25.4 157.311 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "38a14385-5b42-5a48-9f29-df287aa6d250"))
  (text "K1 aux: AUX_A ← +24V_L, AUX_B → U12 → U58 → AUX_RAW (TP8) → GPIO27; debounce U29 → AUX_DB (TP12)" (at 25.4 219.728 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "adef40d2-5cde-5825-baf0-c41995895a0c"))
  (text "STOP / ARM terms: RUN_OK = ¬STOP = S1b∧S2b∧WD_OK∧TH1∧WD_B; ARM_OK (U10 D) = RUN_OK ∧ ¬AUX_DB" (at 210.5345 40 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "f9352c98-ac66-5f85-aa22-f76a76c80292"))
  (text "LATCH clear: CLR̄ = ¬(STOP ∨ FORCE ∨ PRE_TIMEOUT ∨ DISC ∨ UV12 ∨ OC), POR = R9·C9 (wired-AND through D21)" (at 210.5345 156.231 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "98990ad7-dc37-5206-8ad3-321d21be5100"))
  (text "ARM button debounce, U10 LATCH (TP10), U28 RUN (TP13)" (at 389.8835 40 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "81a2b12b-9252-5be5-8371-319447d3e770"))
  (text "K2_DRIVE = LATCH ∧ ¬RUN ∧ ¬PRE_TIMEOUT; U11 1 s pre-charge timer (TP11 K2_DRIVE)" (at 389.8835 189.52 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "9f210816-94ca-5717-b8e4-5d5b1d026b3b"))
  (text "FORCE one-shot U6: Ā = AUX_DB ∧ ¬DISC (falling = K1 opened or DISC), B = 3V3, CLR̄ = ¬K2_DRIVE (U15) (TP9)" (at 584.162 40 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "22f0cf37-2768-5f02-bc60-31f898303164"))
  (text "Coil command U8 = LATCH ∧ WD_OK ∧ (PRE_OK ∨ AUX_DB); discrepancy U17 (40 ms) → DISC" (at 584.162 157.311 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "f957a0ee-b90d-5851-894a-97a9c0d57131"))
  (text "Supervision: U18 12 V UVLO (10.5 V) → UV12; U19 branch overload (16 A, 5 s) → OC" (at 584.162 314.8475 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "ba57090a-bb4e-50d3-b08f-2357c90cfdba"))
  (text "U10 D = S1b ∧ S2b ∧ WD_OK ∧ TH1 ∧ ¬AUX_DB (robot: ∧ WD_B)\nU10 CLRn = ¬(STOP ∨ FORCE ∨ POR ∨ PRE_TIMEOUT ∨ DISC ∨ UV12 ∨ OC), STOP = ¬S1b ∨ ¬S2b ∨ ¬WD_OK ∨ ¬TH1 (robot: ∨ ¬WD_B)\nK2_DRIVE = LATCH & !RUN & !PRE_TIMEOUT; FORCE = U6 (An = AUX_DB & !DISC, B = 3V3, CLRn = !K2_DRIVE).\nEvery logic input reads AUX_DB; only U29 (debounce) and GPIO27 read AUX_RAW.\nGlue gates U40-U63 build the netlist's boolean terms (Origin = added)." (at 25.4 557 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "6315c1ed-8d51-560f-85af-fbc1a6ae8e0e"))
